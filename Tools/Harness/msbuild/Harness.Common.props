<Project>
  <!--
    Harness only (not part of the Unity project).
    Common compiler settings that mirror Unity 6.3 script compilation as closely as
    possible outside the editor: C# 9, no nullable context, no implicit usings, explicit
    file lists (generated), Unity's "suppress common warnings" set.
  -->
  <PropertyGroup>
    <HarnessRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</HarnessRoot>
    <HarnessCacheDir Condition="'$(HarnessCacheDir)' == ''">$(HarnessRoot)/.cache</HarnessCacheDir>
    <HarnessEngineRefDir Condition="'$(HarnessEngineRefDir)' == ''">$(HarnessCacheDir)/unity-refs/engine</HarnessEngineRefDir>
    <HarnessEditorRefDir Condition="'$(HarnessEditorRefDir)' == ''">$(HarnessCacheDir)/unity-refs/editor</HarnessEditorRefDir>
    <HarnessTestRunnerRefDir Condition="'$(HarnessTestRunnerRefDir)' == ''">$(HarnessCacheDir)/unity-refs/testrunner</HarnessTestRunnerRefDir>

    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
    <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- XML documentation is required by the project rules (section 15.3): generate the file
         so that malformed doc comments (CS1570-CS1574, CS1587 ...) are reported. CS1591
         (missing doc on every member) is too broad; the lint checks public types instead. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Unity: PlayerSettings.suppressCommonWarnings = true adds /nowarn:0169,0649,0282,1701,1702. -->
    <NoWarn>$(NoWarn);CS0169;CS0649;CS0282;CS1701;CS1702;CS1591;NU1701;NU1603</NoWarn>
    <RestoreConfigFile>$(HarnessRoot)/nuget.config</RestoreConfigFile>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
</Project>
