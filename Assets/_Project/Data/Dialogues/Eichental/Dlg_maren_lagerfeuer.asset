    - rid: 8292696271173976302
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n100
        editorPosition: {x: 0, y: 0}
        nextNodeId: n110
        exitId: 
        followUp: 0
        speakerId: 
        text: "Ihr schlaft nicht. Ich auch nicht. Das Feuer macht zu viele Ger\xE4usche."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696271173976303
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n110
        editorPosition: {x: 0, y: 0}
        nextNodeId: n120
        exitId: 
        followUp: 0
        speakerId: 
        text: "Mein Vater war Hufschmied in Wei\xDFwall. Ein ehrlicher Schlag, hat er gesagt, ist mehr wert als tausend Worte."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696271173976304
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n120
        editorPosition: {x: 0, y: 0}
        nextNodeId: n200
        exitId: 
        followUp: 0
        speakerId: 
        text: "Mit sechzehn bin ich zur Silberwacht. Mein Bruder war schneller als ich. Er ist nicht zur\xFCckgekommen."
        variants: []
        emotion: 4
        camera: 1
        actions: []
        voiceClipId: 
    - rid: 8292696271173976305
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n200
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: Was ist mit ihm passiert?
          targetNodeId: n210
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: "Und warum pr\xFCft Ihr ausgerechnet mich?"
          targetNodeId: n220
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: c
          text: Schlaft. Ich halte Wache.
          targetNodeId: n230
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
    - rid: 8292696271173976306
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n210
        editorPosition: {x: 0, y: 0}
        nextNodeId: n240
        exitId: 
        followUp: 0
        speakerId: 
        text: Er hat einen Rissgeborenen begleitet. So wie ich jetzt Euch. Man hat nur sein Schwert gefunden.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696271173976307
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n220
        editorPosition: {x: 0, y: 0}
        nextNodeId: n240
        exitId: 
        followUp: 0
        speakerId: 
        text: "Weil Ihr gef\xE4hrlich sein k\xF6nntet. Und weil ich wissen will, ob mein Bruder sich geirrt hat."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696271173976308
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n230
        editorPosition: {x: 0, y: 0}
        nextNodeId: n240
        exitId: 
        followUp: 0
        speakerId: 
        text: "Ihr haltet Wache? F\xFCr mich? \u2026 Das ist neu."
        variants: []
        emotion: 1
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696271173976309
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n240
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: gespraech_1
        followUp: 0
        speakerId: 
        text: Genug geredet. Morgen wird lang.
        variants: []
        emotion: 0
        camera: 0
        actions:
        - rid: 8292696271173976310
        - rid: 8292696271173976311
        voiceClipId: 
    - rid: 8292696271173976310
      type: {class: SetFlag, ns: Aetherfall.WorldState, asm: Aetherfall.WorldState}
      data:
        flagId: flag.begleiter.maren.lagerfeuer
        value: 1
    - rid: 8292696271173976311
      type: {class: AddToFlag, ns: Aetherfall.WorldState, asm: Aetherfall.WorldState}
