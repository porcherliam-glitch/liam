    - rid: 8292696271173976312
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n300
        editorPosition: {x: 0, y: 0}
        nextNodeId: n310
        exitId: 
        followUp: 0
        speakerId: 
        text: Der Wachende Ritter. Hundert Jahre tot, und er hat seinen Posten nicht verlassen.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696271173976313
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n310
        editorPosition: {x: 0, y: 0}
        nextNodeId: n400
        exitId: 
        followUp: 0
        speakerId: 
        text: Die Eichenritter waren wie wir. Ein Eid, ein Wappen, eine Pflicht. Und am Ende Knochen in einer Gruft.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696271173976314
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n400
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: Er hat getan, was er geschworen hat.
          targetNodeId: n410
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: Ein Eid, der einen hundert Jahre bindet, ist ein Fluch.
          targetNodeId: n420
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
    - rid: 8292696271173976315
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n410
        editorPosition: {x: 0, y: 0}
        nextNodeId: n430
        exitId: 
        followUp: 0
        speakerId: 
        text: "Ja. Das ist das Sch\xF6ne daran. Und das Schreckliche."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696271173976316
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n420
        editorPosition: {x: 0, y: 0}
        nextNodeId: n430
        exitId: 
        followUp: 0
        speakerId: 
        text: "Vielleicht. Aber ohne Eide w\xE4re niemand da, der den Riss bewacht."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696271173976317
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n430
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: gespraech_2
        followUp: 0
        speakerId: 
        text: Ihr habt Euch in der Gruft gut geschlagen. Das schreibe ich in meinen Bericht. Ehrlich.
        variants: []
        emotion: 0
        camera: 0
        actions:
        - rid: 8292696271173976318
        - rid: 8292696271173976319
        voiceClipId: 
