    - rid: 8292696249713295447
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n100
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: Eichental brennt, und meine Schafe stehen allein auf der Weide. Ich muss zu ihnen.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295448
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n200
        editorPosition: {x: 0, y: 0}
        nextNodeId: n210
        exitId: 
        followUp: 0
        speakerId: 
        text: Du bist einer von den Leuten aus Eichental, oder? Dann kennst du Not. Ich hab auch welche.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295449
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n210
        editorPosition: {x: 0, y: 0}
        nextNodeId: n220
        exitId: 
        followUp: 0
        speakerId: 
        text: Jede Nacht fehlt ein Schaf. Erst Wolle, dann Flocke, gestern Grete. Gerissen, oben auf der Weide.
        variants: []
        emotion: 4
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295450
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n220
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: Ich sehe mir die Weide an.
          targetNodeId: n230
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: "Sp\xE4ter vielleicht."
          targetNodeId: n290
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
    - rid: 8292696249713295451
      type: {class: ActionNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n230
        editorPosition: {x: 0, y: 0}
        nextNodeId: n240
        exitId: 
        followUp: 0
        actions:
        - rid: 8292696249713295452
    - rid: 8292696249713295452
      type: {class: StartQuest, ns: Aetherfall.Quests, asm: Aetherfall.Quests}
      data:
        questId: quest.side.eichental.woelfe_vom_nordhang
        ignoreStartConditions: 0
    - rid: 8292696249713295453
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n240
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: angenommen
        followUp: 0
        speakerId: 
        text: "Danke. Die obere Weide liegt hinter der Scheune, nach Norden hin. Sieh dir die Spuren an \u2013 die sind seltsam."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295454
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n290
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: vertagt
        followUp: 0
        speakerId: 
        text: Na gut. Aber lang halten meine Schafe das nicht mehr aus.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295455
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n300
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Die Spuren f\xFChren zum Nordhang, sagst du? Pass auf dich auf da oben."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295456
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n400
        editorPosition: {x: 0, y: 0}
        nextNodeId: n410
        exitId: 
        followUp: 0
        speakerId: 
        text: Keine Risse mehr letzte Nacht. Ich danke dir.
        variants:
        - condition:
            rid: 8292696249713295457
          text: "Das Leuchten ist weg, sagst du? Dann sind es wieder nur W\xF6lfe. Damit komme ich klar. Danke."
        - condition:
            rid: 8292696249713295458
          text: "Du hast das Ding mitgenommen? Hoffentlich wei\xDFt du, was du tust. Die W\xF6lfe heulen lauter als je zuvor."
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295457
      type: {class: FlagIs, ns: Aetherfall.WorldState, asm: Aetherfall.WorldState}
      data:
        flagId: flag.eichental.woelfe_ausgang
        comparison: 0
        value: 2
    - rid: 8292696249713295458
      type: {class: FlagIs, ns: Aetherfall.WorldState, asm: Aetherfall.WorldState}
      data:
        flagId: flag.eichental.woelfe_ausgang
        comparison: 0
        value: 3
    - rid: 8292696249713295459
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n410
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: abschluss
        followUp: 0
        speakerId: 
        text: "Nur Pim \u2026 mein Junge hat Fieber, seit derselben Nacht. Die Kr\xE4uterfrau im Westen soll sich auskennen."
        variants: []
        emotion: 4
        camera: 1
        actions: []
        voiceClipId: 
