    - rid: 8292696249821823047
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n100
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: Du lebst! Komm her, schnell, weg von den Flammen!
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249821823048
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n200
        editorPosition: {x: 0, y: 0}
        nextNodeId: n210
        exitId: 
        followUp: 0
        speakerId: 
        text: "Den G\xF6ttern sei Dank, du lebst. Lina \u2026 ich habe sie im Licht verschwinden sehen. Es tut mir so leid."
        variants: []
        emotion: 4
        camera: 1
        actions: []
        voiceClipId: 
    - rid: 8292696249821823049
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n210
        editorPosition: {x: 0, y: 0}
        nextNodeId: n220
        exitId: 
        followUp: 0
        speakerId: 
        text: "Tobold liegt unter einem Balken bei der Schmiede, und Wennas B\xE4ckerei brennt lichterloh. Hilf ihnen, wenn du kannst."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249821823050
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n220
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: dorfrand
        followUp: 0
        speakerId: 
        text: "Ich sammle alle, die noch laufen k\xF6nnen, am Dorfrand. Beeil dich!"
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249821823051
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n300
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: Geh, folge der Gestalt. Ich bringe die Leute nach Lindenhain. Pass auf dich auf.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249821823052
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n400
        editorPosition: {x: 0, y: 0}
        nextNodeId: n405
        exitId: 
        followUp: 0
        speakerId: 
        text: "Du bist zur\xFCck! Was ist am Riss passiert?"
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249821823053
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n405
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: Die graue Gestalt hat auf mich gewartet.
          targetNodeId: n410
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: Lina ist fort. Ich werde sie finden.
          targetNodeId: n420
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
    - rid: 8292696249821823054
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n410
        editorPosition: {x: 0, y: 0}
        nextNodeId: n420
        exitId: 
        followUp: 0
        speakerId: 
        text: "Gewartet? Dann wusste sie, dass du kommst \u2026 Das gef\xE4llt mir nicht."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249821823055
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n420
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: abschluss
        followUp: 0
        speakerId: 
        text: "Lindenhain nimmt uns auf. Hier, mein Notgroschen. Und h\xF6r dich um \u2013 Hollmann und der Gelehrte im Gasthaus brauchen Hilfe."
        variants: []
        emotion: 0
        camera: 0
        actions:
        - rid: 8292696249821823056
        voiceClipId: 
    - rid: 8292696249821823056
      type: {class: SetFlag, ns: Aetherfall.WorldState, asm: Aetherfall.WorldState}
      data:
        flagId: flag.eichental.hedda_bericht_gehoert
        value: 1
    - rid: 8292696249821823057
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n500
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Wir bauen wieder auf, Stein f\xFCr Stein. Hollmann oben am Hof und der Gelehrte im Gasthaus suchen noch Hilfe."
        variants:
        - condition:
            rid: 8292696249821823058
          text: Wenna backt schon wieder, stell dir vor. Hollmann oben am Hof und der Gelehrte im Gasthaus suchen noch Hilfe.
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249821823058
      type: {class: FlagIs, ns: Aetherfall.WorldState, asm: Aetherfall.WorldState}
      data:
        flagId: flag.eichental.wenna_gerettet
        comparison: 0
