    - rid: 8292696253348708554
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n400
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: abgelehnt
        followUp: 0
        speakerId: 
        text: Das entscheidet nicht Ihr. Ich folge Euch auf Befehl, ob es Euch passt oder nicht.
        variants: []
        emotion: 0
        camera: 0
        actions:
        - rid: 8292696253348708555
        - rid: 8292696253348708556
