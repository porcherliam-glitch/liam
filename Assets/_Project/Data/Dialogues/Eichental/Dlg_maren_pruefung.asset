      data:
        id: n600
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: Nichts. Gehen wir.
          targetNodeId: n900
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
