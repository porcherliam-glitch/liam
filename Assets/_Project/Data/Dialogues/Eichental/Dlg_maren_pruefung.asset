      data:
        id: n510
        editorPosition: {x: 0, y: 0}
        nextNodeId: n600
        exitId: 
        followUp: 0
        speakerId: 
        text: Ich bin hier. Was gibt es?
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696253348708560
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n520
        editorPosition: {x: 0, y: 0}
        nextNodeId: n610
        exitId: 
        followUp: 0
        speakerId: 
        text: Ich warte hier, wie befohlen. Soll ich mitkommen?
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696253348708561
