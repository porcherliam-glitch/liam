    - rid: 8292696253348708546
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n100
        editorPosition: {x: 0, y: 0}
        nextNodeId: n110
        exitId: 
        followUp: 0
        speakerId: 
        text: "Ser Maren Falkenried, Silberwacht. Ihr seid der \xDCberlebende vom Riss in Eichental."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696253348708547
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n110
        editorPosition: {x: 0, y: 0}
        nextNodeId: n120
        exitId: 
        followUp: 0
        speakerId: 
        text: "Wer den Riss ber\xFChrt und lebt, hei\xDFt bei uns Rissgeborener. Hauptmann Dorn hat mich geschickt, Euch zu pr\xFCfen."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696253348708548
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n120
        editorPosition: {x: 0, y: 0}
        nextNodeId: n200
        exitId: 
        followUp: 0
        speakerId: 
        text: "Ich begleite Euch eine Weile. Ich sehe zu. Geurteilt wird sp\xE4ter."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696253348708549
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n200
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: "Pr\xFCft mich. Ich habe nichts zu verbergen."
          targetNodeId: n300
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: Was macht die Silberwacht mit Rissgeborenen?
          targetNodeId: n250
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: c
          text: Ich brauche keine Aufpasserin.
          targetNodeId: n400
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
    - rid: 8292696253348708550
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n250
        editorPosition: {x: 0, y: 0}
        nextNodeId: n200
        exitId: 
        followUp: 0
        speakerId: 
        text: Wir nehmen sie in Verwahrung, wenn sie eine Gefahr sind. Ob Ihr eine seid, finde ich heraus.
        variants: []
        emotion: 0
        camera: 1
        actions: []
        voiceClipId: 
    - rid: 8292696253348708551
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n300
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: angenommen
        followUp: 0
        speakerId: 
        text: "Ich hatte mehr Widerstand erwartet. Gut. Geht voran, ich halte Euch den R\xFCcken frei."
        variants: []
        emotion: 0
        camera: 0
        actions:
        - rid: 8292696253348708552
        - rid: 8292696253348708553
        voiceClipId: 
