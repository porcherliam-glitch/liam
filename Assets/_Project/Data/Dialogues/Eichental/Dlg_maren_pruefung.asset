        flagId: flag.main.a1_pruefung_angenommen
        value: 1
    - rid: 8292696253348708553
      type: {class: SetFlag, ns: Aetherfall.WorldState, asm: Aetherfall.WorldState}
      data:
        flagId: stat.begleiter.maren.loyalitaet
