    - rid: 8292696250621362350
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n210
        editorPosition: {x: 0, y: 0}
        nextNodeId: n100
        exitId: 
        followUp: 0
        speakerId: 
        text: "Hollmann flucht \xFCber W\xF6lfe am Nordhang. Jede Nacht ein Schaf weniger, sagt er. Sein Hof liegt im Nordwesten."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362351
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n220
        editorPosition: {x: 0, y: 0}
        nextNodeId: n100
        exitId: 
        followUp: 0
        speakerId: 
        text: Seit dem Riss summt es in der Senke unter dem Rabenfels. Der Gelehrte da hinten will unbedingt hin.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362352
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n230
        editorPosition: {x: 0, y: 0}
        nextNodeId: n100
        exitId: 
        followUp: 0
        speakerId: 
        text: "Die M\xFChle steht still. Banditen sitzen am Wehr, hei\xDFt es. Brenner ist au\xDFer sich."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362353
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n300
        editorPosition: {x: 0, y: 0}
        nextNodeId: n100
        exitId: 
        followUp: 0
        speakerId: 
        text: Bier ist aus. Seit dem Riss trinken alle doppelt. Wasser hab ich noch, das ist umsonst.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362354
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n900
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Komm wieder, wenn du was h\xF6rst."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
