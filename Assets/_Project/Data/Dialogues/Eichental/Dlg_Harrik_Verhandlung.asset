      data:
        id: n110
        editorPosition: {x: 0, y: 0}
        nextNodeId: n115
        exitId: 
        followUp: 0
        speakerId: 
        text: "Brot statt Beute \u2026 Und wenn sie uns in Lindenhain aufkn\xFCpfen?"
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249821822994
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n115
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: "Ich b\xFCrge bei Hedda f\xFCr euch."
          targetNodeId: n130
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: "Bewacht die M\xFChle f\xFCr Brenner. Gegen Mehl."
          targetNodeId: n140
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
    - rid: 8292696249821822995
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n120
        editorPosition: {x: 0, y: 0}
        nextNodeId: n040
        exitId: 
        followUp: 0
        speakerId: 
        text: "Sch\xF6ne Worte. Davon wird keiner satt."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
