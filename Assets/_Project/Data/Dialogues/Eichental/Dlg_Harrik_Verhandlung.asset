        id: n135
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: abzug
        followUp: 0
        speakerId: 
        text: Wenn du gelogen hast, Rissgeborener, finden wir dich.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696248934727706
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n140
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: muehlenwache
        followUp: 0
        speakerId: 
        text: "W\xE4chter statt Wegelagerer. Klingt fast ehrlich. Red mit Brenner."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
