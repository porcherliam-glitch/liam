    - rid: 8292696249713295362
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n015
        editorPosition: {x: 0, y: 0}
        nextNodeId: n030
        exitId: 
        followUp: 0
        speakerId: 
        text: "Leise Schritte f\xFCr jemanden mit so viel Eisen am Leib. Gut. Dann reden wir eben so."
        variants: []
        emotion: 6
        camera: 1
        actions: []
        voiceClipId: 
    - rid: 8292696249713295363
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n020
        editorPosition: {x: 0, y: 0}
        nextNodeId: n025
        exitId: 
        followUp: 0
        speakerId: 
        text: "Noch ein Schritt, und meine Jungs spicken dich mit Bolzen. Wer schickt dich \u2013 Brenner oder die Silberwacht?"
        variants: []
        emotion: 2
        camera: 5
        actions: []
        voiceClipId: 
    - rid: 8292696249713295364
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n025
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: "Der M\xFCller. Er will seine M\xFChle zur\xFCck."
          targetNodeId: n030
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: Niemand. Ich will nur reden.
          targetNodeId: n030
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: c
          text: Ich bin hier, um euch zu erledigen.
          targetNodeId: n900
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
    - rid: 8292696249713295365
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n030
        editorPosition: {x: 0, y: 0}
        nextNodeId: n040
        exitId: 
        followUp: 0
        speakerId: 
        text: "Seine M\xFChle. Ich hab sein Mehl zehn Jahre lang gefahren, dr\xFCben nach Eichental. Ich bin Harrik. Und Eichental gibt's nicht mehr."
        variants: []
        emotion: 0
        camera: 0
        actions:
        - rid: 8292696249713295366
        voiceClipId: 
    - rid: 8292696249713295366
      type: {class: RevealName, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        npcId: npc.eichental.banditenfuehrer_harrik
    - rid: 8292696249713295367
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n040
        editorPosition: {x: 0, y: 0}
        hub: 1
        options:
        - id: a
          text: Ihr seid alle aus Eichental?
          targetNodeId: n050
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 1
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: "Lindenhain nimmt Fl\xFCchtlinge auf. Ihr m\xFCsst nicht stehlen."
          targetNodeId: n100
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: c
          text: "Zieht ab, oder ich hole mir eure K\xF6pfe. Einen nach dem anderen."
          targetNodeId: n200
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: d
          text: "Die Silberwacht r\xFCckt morgen mit drei\xDFig Mann an."
          targetNodeId: n300
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: e
          text: Nehmt das Gold und verschwindet.
          targetNodeId: n400
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: f
          text: Wem zahlt ihr eigentlich Tribut?
          targetNodeId: n500
          visibleIf:
            rid: 8292696249713295368
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: g
          text: Dann regeln wir das mit Stahl.
          targetNodeId: n900
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: h
          text: "Du dr\xFCckst die Klinge tiefer."
          targetNodeId: n910
          visibleIf:
            rid: 8292696249713295369
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 1
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: i
          text: Ich komme wieder.
          targetNodeId: n990
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
