      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n050
        editorPosition: {x: 0, y: 0}
        nextNodeId: n040
        exitId: 
        followUp: 0
        speakerId: 
        text: "Die H\xE4lfte von uns. Hast du gesehen, was von unseren H\xE4usern \xFCbrig ist? Asche. Und Grimmbart will trotzdem seinen Anteil."
        variants: []
        emotion: 4
        camera: 0
