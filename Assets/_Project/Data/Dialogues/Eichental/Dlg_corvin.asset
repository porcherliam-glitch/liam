    - rid: 8292696249713295468
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n100
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: Ein Riss, keine zwei Meilen von hier! Verzeiht, ich habe zu tun.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295469
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n200
        editorPosition: {x: 0, y: 0}
        nextNodeId: n210
        exitId: 
        followUp: 0
        speakerId: 
        text: Corvin Ascher, Aether-Konvent. Seit dem Riss summt es in der Senke unter dem Rabenfels.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295470
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n210
        editorPosition: {x: 0, y: 0}
        nextNodeId: n220
        exitId: 
        followUp: 0
        speakerId: 
        text: "Dort liegt eine Gruft der Eichenritter. Die Inschriften sprechen von einem Siegelstein, der die Toten in ihrem Eid h\xE4lt."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295471
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n220
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: Ich hole Euch den Siegelstein.
          targetNodeId: n230
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: "Klingt nach \xC4rger. Sp\xE4ter."
          targetNodeId: n290
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
    - rid: 8292696249713295472
      type: {class: ActionNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n230
        editorPosition: {x: 0, y: 0}
        nextNodeId: n240
        exitId: 
        followUp: 0
        actions:
        - rid: 8292696249713295473
    - rid: 8292696249713295473
      type: {class: StartQuest, ns: Aetherfall.Quests, asm: Aetherfall.Quests}
      data:
        questId: quest.dungeon.eichental.vergessene_gruft
        ignoreStartConditions: 0
    - rid: 8292696249713295474
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n240
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: angenommen
        followUp: 0
        speakerId: 
        text: "Ausgezeichnet! Die Senke liegt n\xF6rdlich des Dorfes, unter dem Rabenfels. Bringt mir den Stein \u2013 unversehrt."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295475
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n290
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: vertagt
        followUp: 0
        speakerId: 
        text: "Wie Ihr wollt. Der Stein l\xE4uft nicht weg \u2026 hoffe ich."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295476
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n300
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Die Gruft liegt unter dem Rabenfels. Achtet auf die Inschriften \u2013 die Eichenritter liebten R\xE4tsel."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295477
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n500
        editorPosition: {x: 0, y: 0}
        nextNodeId: n510
        exitId: 
        followUp: 0
        speakerId: 
        text: Ihr habt ihn? Den Siegelstein der Eichenritter?
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295478
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n510
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: Hier ist er.
          targetNodeId: n520
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: Ich behalte ihn vorerst.
          targetNodeId: n590
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
    - rid: 8292696249713295479
      type: {class: ActionNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n520
        editorPosition: {x: 0, y: 0}
        nextNodeId: n530
        exitId: 
        followUp: 0
        actions:
        - rid: 8292696249713295480
        - rid: 8292696249713295481
    - rid: 8292696249713295480
      type: {class: RemoveItem, ns: Aetherfall.Inventory, asm: Aetherfall.Inventory}
      data:
        itemId: item.quest.siegelstein_gruft
        amount: 1
    - rid: 8292696249713295481
      type: {class: SetFlag, ns: Aetherfall.WorldState, asm: Aetherfall.WorldState}
      data:
        flagId: flag.eichental.siegelstein_verbleib
        value: 1
    - rid: 8292696249713295482
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n530
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: abgegeben
        followUp: 0
        speakerId: 
        text: "Unglaublich \u2026 er ist warm. Hier, Euer Lohn. Der Konvent wird von Euch h\xF6ren."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295483
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n590
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: vertagt
        followUp: 0
        speakerId: 
        text: "\xDCberlegt es Euch nicht zu lange. So ein Stein geh\xF6rt in kundige H\xE4nde."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295484
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n600
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Der Stein verr\xE4t mir mehr, als ich zu hoffen wagte."
        variants:
        - condition:
            rid: 8292696249713295485
          text: Ihr habt ihn liegen lassen? Bedauerlich. Eure Beschreibung der Reliefs ist trotzdem etwas wert.
        - condition:
            rid: 8292696249713295486
          text: "Ihr tragt den Stein noch bei Euch, nicht wahr? Ich sp\xFCre es."
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696249713295485
      type: {class: FlagIs, ns: Aetherfall.WorldState, asm: Aetherfall.WorldState}
      data:
        flagId: flag.eichental.siegelstein_verbleib
        comparison: 0
        value: 2
