        nextNodeId: n110
        exitId: 
        followUp: 0
        speakerId: 
        text: "Ich dachte, ich verbrenne da drin \u2026 Danke. Danke!"
        variants: []
        emotion: 4
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362322
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n110
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Meine B\xE4ckerei ist weg. Drei\xDFig Jahre Teig, und jetzt nur noch Asche."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362323
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n200
        editorPosition: {x: 0, y: 0}
        nextNodeId: n210
        exitId: 
        followUp: 0
        speakerId: 
        text: "In Lindenhain gibt es einen Ofen, aber kein Mehl. Die M\xFChle am M\xFChlbach mahlt nicht mehr."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362324
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n210
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Sobald wieder Mehl kommt, backe ich. Das erste Brot ist f\xFCr dich."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
