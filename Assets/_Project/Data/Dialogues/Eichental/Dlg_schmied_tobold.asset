    - rid: 8292696252282830989
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n210
        editorPosition: {x: 0, y: 0}
        nextNodeId: n205
        exitId: 
        followUp: 0
        speakerId: 
        text: "Eichental bauen wir wieder auf. Stein f\xFCr Stein, wie Hedda sagt."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696252282830990
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n230
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: handeln
        followUp: 1
        speakerId: 
        text: Schwerter, Schilde, ein paar Plattenteile. Alles ehrliches Eisen.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696252282830991
