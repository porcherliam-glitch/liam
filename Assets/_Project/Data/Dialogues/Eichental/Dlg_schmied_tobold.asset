      data:
        id: n100
        editorPosition: {x: 0, y: 0}
        nextNodeId: n110
        exitId: 
        followUp: 0
        speakerId: 
        text: Du hast mich unter dem Balken hervorgeholt. Das vergess ich dir nicht.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696252282830986
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n110
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: Edwin, mein Junge, ist mit den Ersten nach Lindenhain. Wenigstens er ist in Sicherheit.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696252282830987
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n200
        editorPosition: {x: 0, y: 0}
        nextNodeId: n205
        exitId: 
        followUp: 0
        speakerId: 
        text: Die Esse hier ist klein, aber sie brennt. Was brauchst du?
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696252282830988
      type: {class: ChoiceNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n205
        editorPosition: {x: 0, y: 0}
        hub: 0
        options:
        - id: a
          text: Zeig mir deine Waren.
          targetNodeId: n230
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: b
          text: Wie geht es dir?
          targetNodeId: n210
          visibleIf:
            rid: -2
          selectableIf:
            rid: -2
          lockedReason: 
          once: 0
          irreversible: 0
          actions: []
          choiceId: 
          choiceOptionId: 
        - id: c
          text: "Bis sp\xE4ter."
