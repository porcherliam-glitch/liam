      data:
        id: n100
        editorPosition: {x: 0, y: 0}
        nextNodeId: n110
        exitId: 
        followUp: 0
        speakerId: 
        text: Du hast mich unter dem Balken hervorgeholt. Das vergess ich dir nicht.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362314
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n110
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: Edwin, mein Junge, ist mit den Ersten nach Lindenhain. Wenigstens er ist in Sicherheit.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362315
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n200
        editorPosition: {x: 0, y: 0}
        nextNodeId: n210
        exitId: 
        followUp: 0
        speakerId: 
        text: Die Esse hier ist klein, aber sie brennt. Sobald ich Eisen habe, schmiede ich dir etwas Ordentliches.
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362316
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n210
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Und Eichental bauen wir wieder auf. Stein f\xFCr Stein, wie Hedda sagt."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
