        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Bist du ein Ritter? \u2026 Nein? Papa sagt, nachts kommen W\xF6lfe. Mir ist so hei\xDF, und alles leuchtet ein bisschen."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362332
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n200
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Hast du die W\xF6lfe gesehen? Papa sagt, sie haben leuchtende Augen. Wie in meinen Fiebertr\xE4umen."
        variants: []
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
    - rid: 8292696250621362333
      type: {class: LineNode, ns: Aetherfall.Dialogue, asm: Aetherfall.Dialogue}
      data:
        id: n300
        editorPosition: {x: 0, y: 0}
        nextNodeId: 
        exitId: weiter
        followUp: 0
        speakerId: 
        text: "Papa ist nicht mehr so traurig. Nur mein Kopf ist immer noch hei\xDF."
        variants:
        - condition:
            rid: 8292696250621362334
          text: "Papa sagt, du hast einen Welpen gerettet! Darf ich ihn mal sehen? Mein Kopf ist immer noch hei\xDF."
        emotion: 0
        camera: 0
        actions: []
        voiceClipId: 
