    searchRadius: 50
  - id: s30
    journalText: "Am Nordhang leben W\xF6lfe, die von innen leuchten. Ihr Bau liegt unter dem Wolfskopf-Felsen."
    explorationHint: 
    objectives:
    - rid: 8292696254713430269
    - rid: 8292696254713430270
    completionMode: 0
    requiredCount: 1
    actionOnly: 0
    onStart: []
