  startStageId: 
  startBranches: []
  stages:
  - id: s10
    journalText: Auf der oberen Weide liegen gerissene Schafe. Hollmann hat dir seinen alten Jagdbogen geliehen.
    explorationHint: "Die obere Weide liegt n\xF6rdlich vom Hollmann-Hof. Bogen: F, zielen mit der rechten, spannen mit der linken Maustaste."
    objectives:
    - rid: 8292696254713430259
