    ledgerEntryId: 
    saveLock: 0
    markerIds: []
    searchRadius: 50
  - id: s40
    journalText: "Im Bau steckt ein Aether-Splitter im Fels. Der Leitwolf Glutfang ist mit ihm verwachsen. T\xF6te ihn, zerst\xF6re den Splitter oder brich ihn heraus."
    explorationHint: 
    objectives:
    - rid: 8292696254713430271
