    saveLock: 0
    markerIds: []
    searchRadius: 50
  - id: s20
    journalText: "Das Tor ist versiegelt. Die Inschrift nennt eine Reihenfolge: \u201EErst die Eiche, die den Schild trug, dann die Krone, die sich beugte, zuletzt der Schild, der nie brach.\u201C"
    explorationHint: "Die Gruft liegt in der Senke unter dem Rabenfels, n\xF6rdlich des Dorfes."
    objectives:
    - rid: 8292696281061523780
    - rid: 8292696281061523782
    completionMode: 0
    requiredCount: 1
    actionOnly: 0
