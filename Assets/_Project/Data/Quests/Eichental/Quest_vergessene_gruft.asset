    searchRadius: 50
  - id: s50
    journalText: Vor dem Siegelstein erhebt sich der Wachende Ritter.
    explorationHint: "Die Gruft liegt in der Senke unter dem Rabenfels, n\xF6rdlich des Dorfes."
    objectives:
    - rid: 8292696281061523788
    completionMode: 0
