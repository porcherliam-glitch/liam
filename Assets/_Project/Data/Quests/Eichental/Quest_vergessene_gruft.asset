    endType: 0
    ledgerEntryId: 
    saveLock: 0
    markerIds:
    - obj.eichental.gruft_eingang
    searchRadius: 50
  - id: s30
    journalText: In den Hallen der Eichenritter regen sich die Toten. Die Siegelkammer liegt in der Tiefe.
    explorationHint: "Die Gruft liegt in der Senke unter dem Rabenfels, n\xF6rdlich des Dorfes."
    objectives:
    - rid: 8292696281061523784
    - rid: 8292696281061523785
    completionMode: 0
    requiredCount: 1
    actionOnly: 0
    onStart: []
    onComplete: []
