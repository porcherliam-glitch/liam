    endType: 0
    ledgerEntryId: 
    saveLock: 0
    markerIds:
    - obj.eichental.gruft_eingang
    searchRadius: 50
  - id: s40
    journalText: "Ein Strahl aus Aether-Licht f\xE4llt durch einen Spalt. Drei Spiegel stehen schief in ihren Halterungen."
    explorationHint: "Die Gruft liegt in der Senke unter dem Rabenfels, n\xF6rdlich des Dorfes."
    objectives:
    - rid: 8292696281061523786
    completionMode: 0
    requiredCount: 1
