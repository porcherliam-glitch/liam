<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Main menu (GDD 05 1.3). Buttons are menu items of the own focus layer (not focusable for UI Toolkit). -->
    <ui:VisualElement name="mainmenu" class="af-root af-screen af-mainmenu">
        <ui:VisualElement class="af-mainmenu__backdrop" picking-mode="Ignore">
            <ui:VisualElement class="af-mainmenu__halo af-mainmenu__halo--outer" picking-mode="Ignore" />
            <ui:VisualElement class="af-mainmenu__halo af-mainmenu__halo--inner" picking-mode="Ignore" />
            <ui:VisualElement class="af-mainmenu__rift af-mainmenu__rift--glow" picking-mode="Ignore" />
            <ui:VisualElement class="af-mainmenu__rift" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="af-mainmenu__layout">
            <ui:VisualElement class="af-mainmenu__column">
                <ui:Label name="mainmenu-title" class="af-text af-title" />
                <ui:Label name="mainmenu-subtitle" class="af-text af-subtitle" />
                <ui:VisualElement class="af-divider" />
                <ui:VisualElement name="mainmenu-buttons" class="af-menu-list">
                    <ui:Button name="mainmenu-new-game" class="af-text af-button" focusable="false" />
                    <ui:Button name="mainmenu-continue" class="af-text af-button af-button--two-line" focusable="false">
                        <ui:Label name="mainmenu-continue-info" class="af-text af-button__info" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="mainmenu-load" class="af-text af-button" focusable="false" />
                    <ui:Button name="mainmenu-options" class="af-text af-button" focusable="false" />
                    <ui:Button name="mainmenu-quit" class="af-text af-button" focusable="false" />
                </ui:VisualElement>
                <ui:Label name="mainmenu-status" class="af-text af-page__status" />
            </ui:VisualElement>
            <ui:VisualElement name="mainmenu-page" class="af-mainmenu__page">
                <ui:VisualElement name="mainmenu-load-page" class="af-page" />
                <ui:VisualElement name="mainmenu-options-page" class="af-page" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="af-footer" picking-mode="Ignore">
            <ui:VisualElement class="af-hint" picking-mode="Ignore">
                <ui:Label name="mainmenu-hint-glyph-confirm" class="af-text af-glyph af-glyph--face" picking-mode="Ignore" />
                <ui:Label name="mainmenu-hint-select" class="af-text af-hint__text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="mainmenu-hint-back-group" class="af-hint" picking-mode="Ignore">
                <ui:Label name="mainmenu-hint-glyph-back" class="af-text af-glyph af-glyph--face" picking-mode="Ignore" />
                <ui:Label name="mainmenu-hint-back" class="af-text af-hint__text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="mainmenu-version" class="af-text af-version" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
