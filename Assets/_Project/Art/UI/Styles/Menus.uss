/* Main menu, pause menu and death screen (GDD 05 1.3). */

/* ---------- Main menu ---------- */

.af-mainmenu {
    background-color: #0A0D11;
}

.af-mainmenu__backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

/* A rift in the sky: the only turquoise on the screen belongs to Aether (GDD 05 3.4). */
.af-mainmenu__halo {
    position: absolute;
    border-radius: 640px;
    border-width: 2px;
}

.af-mainmenu__halo--outer {
    right: -260px;
    top: -220px;
    width: 1280px;
    height: 1280px;
    background-color: rgba(47, 230, 214, 0.035);
    border-color: rgba(47, 230, 214, 0.09);
}

.af-mainmenu__halo--inner {
    right: 40px;
    top: 80px;
    width: 680px;
    height: 680px;
    border-radius: 340px;
    background-color: rgba(11, 110, 115, 0.12);
    border-color: rgba(47, 230, 214, 0.16);
}

.af-mainmenu__rift {
    position: absolute;
    right: 360px;
    top: 150px;
    width: 4px;
    height: 560px;
    rotate: 18deg;
    background-color: rgba(230, 255, 252, 0.85);
}

.af-mainmenu__rift--glow {
    right: 349px;
    width: 26px;
    background-color: rgba(47, 230, 214, 0.22);
}

/* Side margins in percent (160 px at 1920): at larger UI sizes the logical screen gets narrower, so the page keeps room. */
.af-mainmenu__layout {
    position: absolute;
    left: 8.33%;
    top: 0;
    right: 8.33%;
    bottom: 0;
    flex-direction: row;
    align-items: center;
}

/* The column keeps its width; the page takes the rest (basis 0, so long texts on the page never squeeze the column). */
.af-mainmenu__column {
    width: 600px;
    flex-shrink: 0;
}

.af-mainmenu__page {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 0 0 80px;
    height: 640px;
    padding: 40px 48px;
    background-color: var(--ui-panel);
    border-width: 1px;
    border-color: var(--ui-panel-border);
    border-radius: 6px;
}

/* Wraps after "Chroniken von", so the title never runs into the page panel on the right. */
.af-title {
    font-size: 76px;
    white-space: normal;
    color: var(--text-title);
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 0px 3px 8px rgba(0, 0, 0, 0.9);
}

.af-subtitle {
    margin: 10px 0 0 4px;
    font-size: var(--font-body);
    color: var(--text-secondary);
    letter-spacing: 4px;
}

/* ---------- Pause menu ---------- */

.af-pause {
    justify-content: center;
}

.af-pause__panel {
    width: 1240px;
    height: 780px;
}

.af-pause__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 28px 40px;
    border-bottom-width: 1px;
    border-color: var(--ui-panel-border);
}

.af-pause__title {
    font-size: var(--font-title);
    color: var(--text-title);
    -unity-font-style: bold;
}

.af-tabs {
    flex-direction: row;
    align-items: center;
}

.af-tabs .af-glyph {
    margin: 0 14px;
}

.af-tab {
    flex-shrink: 0;
    height: 48px;
    margin: 0 4px;
    padding: 0 22px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    font-size: 24px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
}

.af-tab.is-selected {
    color: var(--text-title);
    border-color: var(--accent-gold);
}

.af-pause__body {
    flex-grow: 1;
    padding: 32px 48px 24px 48px;
}

.af-pause__page {
    flex-grow: 1;
}

.af-pause__system {
    flex-direction: row;
}

.af-pause__info {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 0 0 56px;
    padding: 0 0 0 40px;
    border-left-width: 1px;
    border-color: var(--ui-panel-border);
}

.af-pause__info-title {
    font-size: 18px;
    color: var(--text-muted);
    letter-spacing: 1px;
}

.af-pause__last-save {
    margin: 6px 0 28px 0;
    font-size: var(--font-body);
    color: var(--text-primary);
    white-space: normal;
}

.af-pause__status {
    font-size: var(--font-small);
    color: var(--text-secondary);
    white-space: normal;
}

.af-pause__status.is-error {
    color: var(--ui-worse);
}

.af-pause__status.is-ok {
    color: var(--ui-better);
}

/* ---------- Death screen ---------- */

.af-death {
    background-color: rgba(14, 3, 5, 0.86);
}

.af-death__content {
    align-items: center;
}

.af-death__title {
    font-size: 92px;
    color: #E3D2B8;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    text-shadow: 0px 4px 12px rgba(0, 0, 0, 0.95);
}

.af-death__divider {
    width: 360px;
    height: 2px;
    margin: 26px 0 22px 0;
    background-color: var(--accent-blood);
}

.af-death__subtitle {
    margin: 0 0 56px 0;
    font-size: 26px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
}

.af-menu-list--center {
    width: 600px;
}

.af-menu-list--center .af-button {
    -unity-text-align: middle-center;
}

.af-death__info {
    margin: -4px 0 18px 0;
    -unity-text-align: middle-center;
    white-space: normal;
}
