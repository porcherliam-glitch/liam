  m_Name: 
  m_EditorClassIdentifier: Aetherfall.World::Aetherfall.World.NpcBarker
  npcId: npc.eichental.wirt_ulf
  lines:
  - text: Komm rein, die Suppe ist warm. Meistens.
    phases: 01000000i
  - text: "Hier h\xF6rt man mehr Ger\xFCchte als W\xFCrfel klappern."
    phases: 0100000002000000i
  - text: Jetzt wird's voll. Such dir einen Platz, solange es geht.
    phases: 02000000i
  - text: "Zu fr\xFCh. Ab zehn schenk ich aus."
    phases: 0000000003000000i
  text: {fileID: 1024817262}
  playerLayers:
    serializedVersion: 2
    m_Bits: 64
  showSeconds: 4
