  m_Name: 
  m_EditorClassIdentifier: Aetherfall.World::Aetherfall.World.NpcBarker
  npcId: npc.eichental.hauptmann_dorn
  lines:
  - text: Halt dich an die Wege. Die Banditen werden frech.
    phases: 0000000001000000i
  - text: "Das Kopfgeld auf Grimmbart steht noch. Zweihundertf\xFCnfzig Gold."
    phases: 0100000002000000i
  - text: "Neue Aush\xE4nge. Lies sie, bevor der Regen sie holt."
    phases: 02000000i
  - text: "Die Nachtwache ist d\xFCnn. Bleib im Licht."
    phases: 03000000i
  text: {fileID: 2043012146}
  playerLayers:
    serializedVersion: 2
    m_Bits: 64
  showSeconds: 4
