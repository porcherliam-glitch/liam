  m_Script: {fileID: 11500000, guid: a801521081cf4c84da59ddfc74d21462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Aetherfall.World::Aetherfall.World.NpcBarker
  npcId: npc.eichental.bauer_hollmann
  lines:
  - text: Die Schafe sind unruhig, seit der Riss offen ist.
    phases: 0000000001000000i
  - text: Bleib vom Nordhang weg, wenn die Sonne sinkt.
    phases: 01000000i
  - text: Wieder ein Tag ohne Wolf. Gut so.
    phases: 02000000i
  - text: Pim hustet wieder. Sei leise.
    phases: 03000000i
  text: {fileID: 1642175106}
  playerLayers:
    serializedVersion: 2
    m_Bits: 64
  showSeconds: 4
