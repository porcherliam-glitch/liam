  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ba0fb3d0198ec414db10260978974782, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Aetherfall.Cinematics.Playback::Aetherfall.Cinematics.Playback.TimelineCutscenePlayer
  director: {fileID: 1919397259}
  cutsceneId: cs.prolog.erwachen
  cameraRoot: {fileID: 954019890}
  cues:
  - kind: 2
    start: 0
    end: 4.5
    speaker: 
    text: 
    fadeIn: 0
    fadeOut: 1
    color: 0
  - kind: 1
    start: 0.3
    end: 3.4
    speaker: 
    text: Eichental, am Tag des Erntefests.
    fadeIn: 0
    fadeOut: 0
    color: 0
  - kind: 0
    start: 4.7
    end: 9.3
    speaker: 
    text: "Mitten im Fest rei\xDFt der Himmel \xFCber dem Dorf auf."
    fadeIn: 0
    fadeOut: 0
    color: 0
  - kind: 0
    start: 10.3
    end: 14
    speaker: Lina
    text: Das Licht zieht mich fort! Halt mich fest!
    fadeIn: 0
    fadeOut: 0
    color: 0
  - kind: 2
    start: 14.2
    end: 15
    speaker: 
    text: 
    fadeIn: 0.5
    fadeOut: 0
    color: 1
  - kind: 2
    start: 14.8
    end: 20
    speaker: 
    text: 
    fadeIn: 0.2
    fadeOut: 1.5
    color: 0
  - kind: 1
    start: 15.4
    end: 18.3
    speaker: 
    text: Dann nur noch Feuer und Rauch.
    fadeIn: 0
    fadeOut: 0
    color: 0
  - kind: 0
    start: 20.3
    end: 23.4
    speaker: Eine Stimme
    text: "Hilfe! H\xF6rt mich denn niemand?"
    fadeIn: 0
    fadeOut: 0
    color: 0
