  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1478236881}
  m_Text: "Fenn: \u201EDanke, Fremder. Ein paar\nSchritte Richtung Treppe, zwischen\nden beiden Gr\xE4bern an der Westwand,\nist eine lose Platte \u2013 dahinter\nliegt die Kammer, aus der ich nicht\nmehr rauskam.\u201C"
