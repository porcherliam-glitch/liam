{
  "name": "nova-ai",
  "productName": "NOVA AI",
  "version": "0.1.0",
  "description": "NOVA AI – autonomes KI-Entwicklungsstudio für Windows",
  "author": "NOVA AI",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/build.mjs && electron .",
    "daemon": "node scripts/build.mjs --only daemon && node out/daemon/index.cjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/build.mjs && playwright test",
    "verify:ollama": "node scripts/build.mjs --only daemon && node scripts/verify-ollama.mjs",
    "verify:comfyui": "node scripts/build.mjs --only daemon && node scripts/verify-comfyui.mjs",
    "dist:win": "node scripts/build.mjs && electron-builder --win nsis --x64",
    "dist:dir": "node scripts/build.mjs && electron-builder --dir"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
